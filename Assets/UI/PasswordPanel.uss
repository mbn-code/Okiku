#root {
    position: absolute;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
    width: 100%;
    height: 100%;
}

#dialog {
    background-color: #2c2c2c;
    border-radius: 8px;
    padding: 20px;
    flex-direction: column;
    align-items: center;
    width: 300px;
}

#PromptLabel,
#FeedbackText {
    text-align: center;
}

#PasswordInput,
#SubmitButton {
    width: 100%;
    margin-bottom: 10px;
}
