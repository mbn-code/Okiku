<engine:UIDocument xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:engine="UnityEngine.UIElements">
  <ui:VisualElement name="root" style="flex-direction: column; justify-content: center; align-items: center; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5);">
    
    <ui:VisualElement name="dialog" style="width: 300px; padding: 20px; background-color: #222; border-radius: 10px; align-items: center;">
      <ui:Label name="PromptLabel" text="Enter the password:" style="color: white; margin-bottom: 10px;" />

      <ui:TextField name="PasswordInput" style="width: 100%; margin-bottom: 10px;" />

      <ui:Button name="SubmitButton" text="Submit" style="width: 100%; margin-bottom: 10px;" />

      <ui:Label name="FeedbackText" text="" style="color: red; height: 20px;" />
    </ui:VisualElement>
    
  </ui:VisualElement>
</engine:UIDocument>
