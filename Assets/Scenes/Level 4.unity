  ThirdCharacterImage: {fileID: 21300000, guid: f3bb85ab24e1fa942a3b8b6cc8c6417d,
    type: 3}
  ThirdAudioClip: {fileID: 8300000, guid: 96d650d70b5e1c2479deaf699d55f3ab, type: 3}
  YappingList:
  - 'Yes, you are beautiful, Okiku. Your soul is radiant. We all could feel the warmth
    you gave off when we were near your presence. '
  - 'We tried to stop you, to prevent this outcome. You are just a small, young,
    and innocent girl who had a bright future ahead. '
  - 'But life has its mountains and valleys, and sometimes you have to accept your
    fate. '
  - 'I know you miss your family, Okiku-chan. '
  - 'You should know that your brother has been sitting by the window every day at
    the same time, hoping for your return. '
  - "Your family misses you dearly, but you cannot return to the real world, Okiku.
    You\u2019re probably wondering why you\u2019re in this grim and cruel world. "
  - "The harsh truth is... you are dead, Okiku. It\u2019s time for you to rest in
    peace. "
  YapperName: Kuchisake
  YapperSprite: {fileID: 21300000, guid: f77c52abf70a9664bbb1d147d30b2bb0, type: 3}
  YapperAudioClip:
  - {fileID: 8300000, guid: 08ea291b3bc4d8e4387c0e80927cc5a5, type: 3}
  - {fileID: 8300000, guid: 1e2eaad1788bac54993239c6e3eede69, type: 3}
