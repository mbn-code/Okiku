  CharacterNames:
  - Okiku
  CharacterSprites:
  - {fileID: 21300000, guid: f3bb85ab24e1fa942a3b8b6cc8c6417d, type: 3}
  Dialogues:
  - "It\u2019s snowing. I love snow, it\u2019s so beautiful and fun to play in. But
    it\u2019s always so cold. I\u2019m freezing, and I don\u2019t know where I am. "
  - 'I want to go home. Where are they? I need to find them. Hmmm, maybe these footprints
    will lead me home. '
  DialogueSounds:
